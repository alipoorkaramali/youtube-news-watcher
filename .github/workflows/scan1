name: YouTube Multi-Watcher v.1🔎📽️📼

on:
  schedule:
    - cron: '*/15 * * * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  watch:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Install dependencies
        run: |
          pip install -r requirements.txt
          pip install yt-dlp   # برای استخراج اطلاعات پلی‌لیست ساندکلاد

      - name: Run scanner
        run: python youtube_scanner.py

      - name: Commit logs and cache
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: 'Update logs & cache & new_videos'
          file_pattern: 'logs/ cache/'
